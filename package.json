{
	"name": "minimal-cv",
	"version": "0.1.1",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build --webpack",
		"start": "next start",
		"prepare": "husky",
		"lint": "pnpm biome lint --only=nursery/useSortedClasses --only=source/noDuplicateClasses app components lib data messages scripts i18n.ts middleware.ts next.config.mjs tailwind.config.ts postcss.config.mjs",
		"lint:fix": "pnpm biome lint --write --unsafe --only=nursery/useSortedClasses --only=source/noDuplicateClasses app components lib data messages scripts i18n.ts middleware.ts next.config.mjs tailwind.config.ts postcss.config.mjs",
		"format": "pnpm biome format --write .",
		"check": "pnpm lint && pnpm build",
		"optimize-images": "node scripts/optimize-images.js",
		"cf:build": "npx @cloudflare/next-on-pages@1",
		"cf:deploy": "pnpm cf:build && wrangler pages deploy .vercel/output/static --project-name keyzh"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,css,json,jsonc,mjs,cjs}": [
			"pnpm biome lint --write --unsafe --only=nursery/useSortedClasses --only=source/noDuplicateClasses",
			"pnpm biome format --write"
		]
	},
